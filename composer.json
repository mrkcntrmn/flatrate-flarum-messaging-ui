{
    "name": "flatrate/flarum-messaging-ui",
    "description": "Unified Messages shell for FlatRate.wiki Flarum 1.8 and Flarum 2.0 (Live Chat + Direct Messages presentation).",
    "keywords": [
        "flarum",
        "flatrate",
        "messages",
        "messaging"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "FlatRate.wiki",
            "homepage": "https://flatrate.wiki"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.3",
        "flarum/core": "^1.8.19 || ^2.0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\MessagingUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\MessagingUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev",
            "dev-feat/forum-f2-messaging-ui-001": "2.0.x-dev"
        },
        "flarum-extension": {
            "title": "Messages",
            "category": "feature",
            "icon": {
                "name": "fas fa-paper-plane",
                "backgroundColor": "#1f2937",
                "color": "#ffffff"
            }
        }
    }
}
